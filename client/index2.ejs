<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rock Paper Scissors</title>
    <script src="/socket.io/socket.io.js"></script>
    <link rel="stylesheet" href="../newstyle.css" />
    <link rel="stylesheet" href="../public/css/match-timer.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
    />
    <script>
      // Define user object as a global variable accessible in client-side JavaScript
      var user = {
        name: "<%= user.name %>",
        isLoggedIn: "<%= user.isLoggedIn %>", // Boolean value, no need for quotes
      };
    </script>
    <style>
      body {
        background-image: url("../magic-portal-on-alien-planet-space-landscape-free-vector.jpg");
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
      }
    </style>
  </head>

  <body>
    <div class="container">
      <header>
        <h1>Rock Paper Scissors</h1>
      </header>
      <div id="modeSelect" class="card">
        <button onclick="showFriendMode()">Play with Friend</button>
        <button onclick="startComputerMode()">Play with Computer</button>
      </div>

      <div id="initial" class="card" style="display: none">
        <input
          type="text"
          id="playerName"
          placeholder="Enter your username"
          value="<%= user.name !== 'Guest' ? user.name : '' %>"
          required
        />
        <button onclick="createGame()">Create Game</button>
        <p>or</p>
        <input
          type="text"
          id="roomUniqueId"
          placeholder="Enter room code"
          required
        />
        <button onclick="joinGame()">Join Game</button>
        <button onclick="showModeSelect()">Back</button>
      </div>

      <div id="computerGame" class="card" style="display: none">
        <p id="computerScoreText">You: 0 &nbsp; Computer: 0</p>
        <p id="rpsComputerTimer" class="match-timer"></p>
        <div id="computerGameArea">
          <div class="playerSection">
            <h2>You:</h2>
            <div id="computerPlayerChoice">
              <button onclick="sendComputerChoice('Rock')">Rock</button>
              <button onclick="sendComputerChoice('Paper')">Paper</button>
              <button onclick="sendComputerChoice('Scissors')">Scissors</button>
            </div>
          </div>
          <div class="playerSection">
            <h2>Computer:</h2>
            <div id="computerOpponentChoice">
              <p id="computerState">Make a choice</p>
            </div>
          </div>
        </div>
        <div id="computerResult" style="display: none">
          <hr />
          <h2 id="computerResultText"></h2>
        </div>
        <button id="computer-play-again" onclick="playComputerAgain()">
          Next Round
        </button>
        <button id="computer-new-match" onclick="startComputerMode()">
          New Match
        </button>
        <button onclick="showModeSelect()">Back</button>
      </div>

      <div id="gamePlay" class="card" style="display: none">
        <p id="rpsFriendTimer" class="match-timer"></p>
        <div id="waitingArea"></div>
        <div id="socialShareButtons"></div>
        <div id="gameArea" style="display: none">
          <div class="playerSection">
            <h2 id="ch1">You:</h2>
            <div id="player1Choice">
              <button onclick="sendChoice('Rock')">Rock</button>
              <button onclick="sendChoice('Paper')">Paper</button>
              <button onclick="sendChoice('Scissors')">Scissors</button>
            </div>
          </div>
          <div class="playerSection">
            <h2 id="ch2">Opponent:</h2>
            <div id="player2Choice">
              <p id="opponentState">Waiting For Opponent....</p>
            </div>
          </div>
        </div>

        <div id="winnerArea" style="display: none">
    <hr />
    <h2 id="winnerText"></h2>

    <button id="next-round" type="button">Next Round</button>
    <button id="new-game">
        New Match
    </button>
</div>
      </div>
    </div>

    <script src="../public/js/matchTimer.js"></script>
    <script src="../client.js"></script>
  </body>
</html>
